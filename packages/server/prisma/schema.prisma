generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
}

model admin {
  id            Int       @id @default(autoincrement())
  first_name    String    @db.VarChar(100)
  last_name     String    @db.VarChar(100)
  email         String    @unique @db.VarChar(255)
  password_hash String    @db.VarChar(255)   // need to activate
  role          user_role @default(admin)
  session       session[]   // admin 1 to many session
}

model user {
  id            Int       @id @default(autoincrement())
  email         String    @unique @db.VarChar(255)
  password_hash String    @db.VarChar(255)   // need to activate
  address       String    @db.VarChar(255)
  position      String    @db.VarChar(255)    
  role          user_role @default(employee)
  first_name    String    @db.VarChar(100)
  last_name     String    @db.VarChar(100)
  employment_type   employement_type  @default(full_time)
  status        status    @default(in_active)
  phone         String   @unique @db.VarChar(20)
  salary        Decimal  @db.Decimal(10, 2)
  emergency_contact String? @db.VarChar(100)
  emergency_phone  String? @db.VarChar(20)
  start_date    DateTime? @default(now()) @db.Timestamp(6)
  updated_at    DateTime? @updatedAt

  session      session[]   // A user may have multiple session
  department_id        Int
  department           department @relation("DepartmentEmployees",fields: [department_id], references: [id])
  managed_department   department?  @relation("DepartmentManager")

  @@index([start_date])
}

model session {
  id             Int              @id @default(autoincrement())
  owner_type     SessionOwnerType
  user_id        Int?
  admin_id       Int?
  user           user?        @relation(fields: [user_id], references: [id])
  admin          admin?           @relation(fields: [admin_id], references: [id])
  refresh_token  String           @unique @db.VarChar(255)
  expires_at     DateTime         @db.Timestamp()
  created_at     DateTime?        @default(now()) @db.Timestamp(6)
  updated_at     DateTime?        @updatedAt
}

model department {
  id                      Int               @id @default(autoincrement())
  manager_id              Int?              @unique
  name                    String            @unique @db.VarChar(50)
  location                String            @db.VarChar(100)
  budget                  Decimal           @db.Decimal(10, 2)
  budget_utilization      Int     
  open_position           Int                 
  employee_count           Int  
  description             String?           @db.VarChar(255)           
  established             DateTime?         @default(now()) @db.Timestamp()
  updated_at              DateTime?         @updatedAt
  user                    user[]            @relation("DepartmentEmployees")// A department may have multiple users     
  manager                 user?             @relation("DepartmentManager", fields: [manager_id], references: [id])
}

enum user_role {
  admin
  manager
  employee
}

enum employement_type {
  full_time
  part_time
  contract
}

enum status {
  in_active
  active
  on_leave
}

enum SessionOwnerType {
  employee
  manager
  admin
}
