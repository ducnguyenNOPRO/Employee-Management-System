generator client {
  provider        = "prisma-client"
  output          = "../generated/prisma"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
}

model admin {
  id            String    @id @default(cuid())
  first_name    String    @db.VarChar(100)
  last_name     String    @db.VarChar(100)
  email         String    @unique @db.VarChar(255)
  password_hash String    @db.VarChar(255) // need to activate
  role          user_role @default(ADMIN)
  session       session[] // admin 1 to many session
}

model user {
  id                String           @id @default(cuid())
  department_id     String?
  location_id       String     // Store ID

  email             String           @unique @db.VarChar(255)
  password_hash     String?           @db.VarChar(255) // need to activate
  address           String           @db.VarChar(255)
  position          String           @db.VarChar(255)
  role              user_role        @default(EMPLOYEE)
  first_name        String           @db.VarChar(100)
  last_name         String           @db.VarChar(100)
  employment_type   employement_type @default(FULL_TIME)
  status            status           @default(IN_ACTIVE)
  phone             String           @unique @db.VarChar(20)
  hourly_rate       Decimal          @db.Decimal(10, 2)
  emergency_contact String?          @db.VarChar(100)
  emergency_phone   String?          @db.VarChar(20)
  start_date        DateTime?        @default(now())
  updated_at        DateTime?        @updatedAt

  session            session[] // A user may have multiple session

  department         department? @relation("DepartmentEmployees", fields: [department_id], references: [id], onDelete: SetNull)  // department this user belong to
  managed_department department? @relation("DepartmentManager")    // The department this manager is managing
  location           location    @relation(fields: [location_id], references: [id])

  leave_request   leave_request[] @relation("Requester")
  approve_request leave_request[] @relation("Approver")

  invitation      invitation[]

  leave_balances leave_balance[]

  time_entries   time_entry[]
  time_entry_edit  time_entry_edit[]
  shifts         shift[]

  @@index([start_date])
}

model session {
  id            String           @id @default(cuid())
  owner_type    SessionOwnerType
  user_id       String?
  admin_id      String?
  user          user?            @relation(fields: [user_id], references: [id])
  admin         admin?           @relation(fields: [admin_id], references: [id])
  refresh_token String           @unique @db.VarChar(255)
  expires_at    DateTime
  created_at    DateTime?        @default(now())
  updated_at    DateTime?        @updatedAt
}

model department {
  id                 String    @id @default(cuid())
  manager_id         String?   @unique
  name               String    @unique @db.VarChar(50)
  location           String    @db.VarChar(100)
  budget             Decimal   @db.Decimal(10, 2)
  budget_utilization Int
  open_position      Int
  employee_count     Int
  description        String?   @db.VarChar(255)
  established        DateTime? @default(now())
  updated_at         DateTime? @updatedAt
  user               user[]    @relation("DepartmentEmployees") // A department may have multiple users     
  manager            user?     @relation("DepartmentManager", fields: [manager_id], references: [id], onDelete: SetNull)
}

model leave_balance {
  id      String    @id @default(cuid())
  user_id String
  type    LeaveType

  total Float
  used  Float

  user user @relation(fields: [user_id], references: [id])

  @@unique([user_id, type])
  @@index([user_id])
}

model leave_request {
  id              String             @id @default(cuid())
  requester_id    String
  approver_id     String?
  location_id     String

  type            LeaveType
  start_date      DateTime
  end_date        DateTime?
  hours           Float // Total hours requested
  reason          String?            @db.VarChar(255)
  status          LeaveRequestStatus @default(PENDING)
  status_priority Int                @default(1)

  // Audit fields
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  reviewed_at DateTime? // When approved/rejected

  // Relations
  requester user  @relation("Requester", fields: [requester_id], references: [id], onDelete: Cascade)
  approver  user? @relation("Approver", fields: [approver_id], references: [id], onDelete: SetNull)
  location  location @relation(fields: [location_id], references: [id])

  @@index([requester_id])
  @@index([status])
  @@index([start_date])
  @@index([location_id])
}

model invitation {
  id              String        @id @default(cuid())

  user_id         String        
  user            user          @relation(fields: [user_id], references: [id], onDelete: Cascade)        
  token_hash      String        @db.VarChar(255) 

  expires_at      DateTime
  accepted_at     DateTime?     // null = not used
  revoked_at      DateTime?     // null = still valid

  created_at     DateTime      @default(now())

  @@index([user_id])
  @@index([token_hash])
}

model location {
  id          String      @id @default(dbgenerated("(floor(random() * 900000) + 100000)::text"))
  street      String
  street2     String?
  city        String
  state       String
  zip_code    String
  country     String      @default("US")

  shifts      shift[]
  users       user[]
  leave_requests  leave_request[]
}

model shift {
  id                String    @id @default(cuid())
  user_id           String
  location_id       String

  notes             String?   @db.VarChar(255)
  
  start_time        DateTime
  end_time          DateTime
  
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt

  // relation
  time_entries      time_entry[]
  user              user      @relation(fields: [user_id], references: [id])
  location          location  @relation(fields: [location_id], references: [id])

  @@index([user_id, start_time])
  @@index([location_id])
}


// Actual work
model time_entry{
  id               String     @id @default(cuid())
  user_id          String

  shift_id         String   

  clock_in         DateTime?
  clock_out        DateTime?  // null = active session

  type             time_entry_type  // WORK | ABSENT

  created_at       DateTime   @default(now())
  updated_at       DateTime   @updatedAt

  // relation
  user             user       @relation(fields: [user_id], references: [id], onDelete: Restrict)
  shift            shift      @relation(fields: [shift_id], references: [id], onDelete: Restrict)

  time_entry_edit  time_entry_edit[]

  @@unique([user_id, shift_id])
  @@index([shift_id])     // dashboard per location/day
  @@index([user_id])      // employee history
}

model time_entry_edit{
  id              String     @id  @default(cuid())
  time_entry_id   String     
  
  old_clock_in    DateTime?
  old_clock_out   DateTime?

  new_clock_in    DateTime?
  new_clock_out   DateTime?

  reason          String     @db.VarChar(255)
  edited_by_id    String
  edited_by       user      @relation(fields: [edited_by_id], references: [id])
  time_entry      time_entry @relation(fields: [time_entry_id], references: [id], onDelete: Cascade)

  created_at      DateTime  @default(now())
  @@index([time_entry_id])
}

enum user_role {
  ADMIN
  MANAGER
  EMPLOYEE
}

enum employement_type {
  FULL_TIME
  PART_TIME
  CONTRACT
}

enum status {
  IN_ACTIVE
  ACTIVE
  ON_LEAVE
}

enum SessionOwnerType {
  EMPLOYEE
  MANAGER
  ADMIN
}

enum LeaveType {
  VACATION
  SICK_LEAVE
}

enum LeaveRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum time_entry_type{
  WORK
  ABSENT
}
